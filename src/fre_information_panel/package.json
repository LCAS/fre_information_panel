{
  "name": "fre_information_panel",
  "version": "0.1.0",
  "author": "Josh Cooper <joshcooper@lincoln.ac.uk>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "lint": "NODE_OPTIONS=--experimental-strip-types eslint .",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types eslint . --fix",
    "format": "prettier --write ../../README.md ../../compose.yaml ../../.devcontainer/devcontainer.json ../../.devcontainer/compose.yaml ../../.github/workflows/*.yml ./index.html ./package.json ./tsconfig.json ./vite.config.ts ./web.json ./server.ts ./eslint.config.ts ./src/**/*.{ts,tsx,css} ./public/config.json ./public/manifest.webmanifest",
    "format:check": "prettier --check ../../README.md ../../compose.yaml ../../.devcontainer/devcontainer.json ../../.devcontainer/compose.yaml ../../.github/workflows/*.yml ./index.html ./package.json ./tsconfig.json ./vite.config.ts ./web.json ./server.ts ./eslint.config.ts ./src/**/*.{ts,tsx,css} ./public/config.json ./public/manifest.webmanifest",
    "style": "npm run format:check && npm run lint",
    "start:bridge": "rclnodejs-web web.json",
    "start:ui": "node --experimental-strip-types server.ts",
    "postinstall": "npx generate-ros-messages"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "lucide-react": "^1.17.0",
    "rclnodejs": "^2.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.11.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.36.0",
    "vite": "^6.0.0"
  }
}
