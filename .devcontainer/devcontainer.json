{
	"name": "FRE Information Panel",
	"dockerComposeFile": [
		"compose.yaml"
	],
	"service": "develop",
	"workspaceFolder": "/workspace",
	"remoteUser": "root",

	"forwardPorts": [
		"5173",
		"9000"
	],
	"portsAttributes": {
		"5173": {
			"label": "Information Panel"
		},
		"9000": {
			"label": "ROS2 Web Tools Web Socket"
		}
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"GitHub.vscode-pull-request-github",
				"ms-vscode.cpptools",
				"JaehyunShim.vscode-ros2",
				"nonanonno.vscode-ros2",
				"deitry.colcon-helper",
				"github.vscode-github-actions"
			]
		}
	},
	"hostRequirements": {
		"cpus": 1,
		"memory": "2gb"
	}
}
